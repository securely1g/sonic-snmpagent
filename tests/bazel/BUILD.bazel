load("@rules_distroless//distroless:defs.bzl", "flatten")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@snmpagent_tests_pip//:requirements.bzl", "requirement")

_RUNTIME_DEPS = [
    "@sonic_snmpagent//:sonic_snmpagent",
    "@sonic_buildimage//src/sonic-py-common:sonic_py_common",
    "@sonic_swss_common//pyext:swsscommon",
]

py_binary(
    name = "unit_runner",
    testonly = True,
    srcs = ["unit_runner.py"],
    data = ["@sonic_snmpagent//:test_sources"],
    legacy_create_init = False,
    python_version = "3.13",
    deps = _RUNTIME_DEPS + [
        requirement("mock"),
        requirement("mockredispy"),
        requirement("pytest"),
        requirement("pytest-cov"),
        requirement("swsssdk"),
    ],
)

sh_test(
    name = "unit_tests",
    size = "large",
    timeout = "long",
    srcs = ["@sonic_swss_common//tools/bazel/runtime:run_with_runtime.py"],
    args = [
        "$(rootpath @sonic_swss_common//tools/bazel/runtime:test_runtime)",
        "-",
        "enabled",
        "$(rootpath :unit_runner)",
        "$(rootpath @sonic_snmpagent//:setup.py)",
    ],
    data = [
        ":unit_runner",
        "@sonic_snmpagent//:setup.py",
        "@sonic_snmpagent//:test_sources",
        "@sonic_swss_common//tools/bazel/runtime:test_runtime",
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

py_binary(
    name = "installed_wheel_runner",
    testonly = True,
    srcs = [
        "installed_wheel_probe.py",
        "service_fixture.py",
    ],
    data = [
        "@sonic_buildimage//src/sonic-py-common:sonic_py_common_wheel",
        "@sonic_snmpagent//:setup.py",
        "@sonic_snmpagent//:snmp_install",
        "@sonic_snmpagent//:sonic_snmpagent_wheel",
        "@sonic_snmpagent//:test_sources",
    ],
    legacy_create_init = False,
    main = "installed_wheel_probe.py",
    python_version = "3.13",
    deps = _RUNTIME_DEPS + ["@sonic_buildimage//tools/bazel/tests:wheel_test_helpers"],
)

sh_test(
    name = "installed_wheel_test",
    size = "medium",
    srcs = ["@sonic_swss_common//tools/bazel/runtime:run_with_runtime.py"],
    args = [
        "$(rootpath :service_runtime)",
        "-",
        "enabled",
        "$(rootpath :installed_wheel_runner)",
        "--wheel=$(rootpath @sonic_snmpagent//:sonic_snmpagent_wheel)",
        "--setup=$(rootpath @sonic_snmpagent//:setup.py)",
        "--common-wheel=$(rootpath @sonic_buildimage//src/sonic-py-common:sonic_py_common_wheel)",
        "--install-tar=$(rootpath @sonic_snmpagent//:snmp_install)",
    ],
    data = [
        ":installed_wheel_runner",
        ":service_runtime",
        "@sonic_buildimage//src/sonic-py-common:sonic_py_common_wheel",
        "@sonic_snmpagent//:setup.py",
        "@sonic_snmpagent//:snmp_install",
        "@sonic_snmpagent//:sonic_snmpagent_wheel",
        "@sonic_snmpagent//:test_sources",
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

flatten(
    name = "service_runtime",
    testonly = True,
    deduplicate = True,
    tars = [
        "@sonic_swss_common//tools/bazel/runtime:test_runtime",
        "@snmp_test_services//redis-server",
        "@snmp_test_services//snmp",
        "@snmp_test_services//snmpd",
    ],
)
